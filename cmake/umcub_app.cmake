# Application-side helpers (loaded by lib/umcub_app/CMakeLists.txt).

# Flash window of each slot, for applications that keep their own linker
# script: UMCUB_APP_FLASH_ORIGIN_<image>_<slot> / UMCUB_APP_FLASH_LENGTH_<image>_<slot>
foreach(_img 0 1)
  foreach(_slot 0 1)
    if(_slot EQUAL 0)
      set(_a ${UMCUB_CFG_IMG${_img}_PRIMARY_ADDR})
      set(_s ${UMCUB_CFG_IMG${_img}_PRIMARY_SIZE})
    else()
      set(_a ${UMCUB_CFG_IMG${_img}_SECONDARY_ADDR})
      set(_s ${UMCUB_CFG_IMG${_img}_SECONDARY_SIZE})
    endif()
    if(_s)
      math(EXPR _o "${_a} + ${UMCUB_CFG_IMAGE_HEADER_SIZE}" OUTPUT_FORMAT HEXADECIMAL)
      math(EXPR _l "${_s} - ${UMCUB_CFG_IMAGE_HEADER_SIZE} - ${UMCUB_CFG_TRAILER_RESERVE}" OUTPUT_FORMAT HEXADECIMAL)
      set(UMCUB_APP_FLASH_ORIGIN_${_img}_${_slot} ${_o})
      set(UMCUB_APP_FLASH_LENGTH_${_img}_${_slot} ${_l})
    endif()
  endforeach()
endforeach()

# umcub_app_linker_script(<target> [IMAGE <n>] [SLOT <0|1>] [TEMPLATE <file.ld>])
# Links <target> for the slot: its MEMORY fragment (umcub_app_img<n>_slot<m>.ld in
# UMCUB_CONFIG_DIR) + the family's port/<fam>/ld/app_<core>_sections.ld; with
# TEMPLATE, that file is your whole linker script (INCLUDE the fragment in it).
function(umcub_app_linker_script target)
  cmake_parse_arguments(A "" "IMAGE;SLOT;TEMPLATE" "" ${ARGN})
  if(NOT DEFINED A_IMAGE)
    set(A_IMAGE 0)
  endif()
  if(NOT DEFINED A_SLOT)
    set(A_SLOT 0)
  endif()
  set(_frag "${UMCUB_CONFIG_DIR}/umcub_app_img${A_IMAGE}_slot${A_SLOT}.ld")
  if(NOT EXISTS "${_frag}")
    message(FATAL_ERROR "umcub: ${target}: this configuration has no image ${A_IMAGE} slot ${A_SLOT}")
  endif()
  if(A_TEMPLATE)
    get_filename_component(_out "${A_TEMPLATE}" ABSOLUTE)
  else()
    get_filename_component(_body_name "${UMCUB_FAMILY_APP_LD}" NAME)
    set(_out "${CMAKE_CURRENT_BINARY_DIR}/${target}_img${A_IMAGE}_slot${A_SLOT}.ld")
    file(CONFIGURE OUTPUT "${_out}" @ONLY CONTENT
      "/* Generated by umcub_app_linker_script() */\nINCLUDE umcub_app_img${A_IMAGE}_slot${A_SLOT}.ld\nINCLUDE ${_body_name}\n")
    target_link_options(${target} PRIVATE "-L${UMCUB_FAMILY_DIR}/ld")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${UMCUB_FAMILY_APP_LD}")
  endif()
  target_link_options(${target} PRIVATE -T${_out} "-L${UMCUB_CONFIG_DIR}" "-L${UMCUB_ROOT}/port/arch/cortexm")
  set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${_out}" "${_frag}")
endfunction()

# umcub_add_application(<target> [IMAGE <n>] [SLOT <0|1>] [VERSION <x.y.z>]
#                       [TEMPLATE <file.ld>] [<umcub_sign_image() options>])
# The usual three steps for an application in one call: links umcub::app
# (${UMCUB_APP_LIB}), links <target> for the slot (umcub_app_linker_script())
# and signs it (umcub_sign_image(): <target>.signed.bin / .hex). Applications
# with their own linker script call the two functions themselves.
function(umcub_add_application target)
  cmake_parse_arguments(A "" "IMAGE;SLOT;TEMPLATE" "" ${ARGN})
  if(NOT DEFINED A_IMAGE)
    set(A_IMAGE 0)
  endif()
  if(NOT DEFINED A_SLOT)
    set(A_SLOT 0)
  endif()
  target_link_libraries(${target} PRIVATE ${UMCUB_APP_LIB})
  if(A_TEMPLATE)
    umcub_app_linker_script(${target} IMAGE ${A_IMAGE} SLOT ${A_SLOT} TEMPLATE ${A_TEMPLATE})
  else()
    umcub_app_linker_script(${target} IMAGE ${A_IMAGE} SLOT ${A_SLOT})
  endif()
  umcub_sign_image(${target} IMAGE ${A_IMAGE} SLOT ${A_SLOT} ${A_UNPARSED_ARGUMENTS})
endfunction()
