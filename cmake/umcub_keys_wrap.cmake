# Wraps imgtool key dumps into the tables MCUboot expects:
#   MODE pub (default): `imgtool getpub --lang c` in RAW -> bootutil_keys[] (signature check)
#   MODE enc:           `IMGTOOL getpriv -k KEY`, run here -> bootutil_enc_key (image decryption); the private
#                       key stays in memory, no intermediate file
if(MODE STREQUAL "enc")
  execute_process(COMMAND "${IMGTOOL}" getpriv -k "${KEY}" OUTPUT_VARIABLE _key RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "umcub: imgtool getpriv -k ${KEY} failed (${_rc})")
  endif()
  file(TOUCH "${OUT}")                                        # the device private key: owner only before it is written
  file(CHMOD "${OUT}" PERMISSIONS OWNER_READ OWNER_WRITE)
  file(WRITE "${OUT}" "/* Generated by umcub from the device key - do not edit. */
#include \"bootutil/sign_key.h\"

${_key}
const struct bootutil_key bootutil_enc_key = {
    .key = enc_priv_key,
    .len = &enc_priv_key_len,
};
")
else()
  file(READ "${RAW}" _key)
  file(WRITE "${OUT}" "/* Generated by umcub from the signing key - do not edit. */
#include \"bootutil/sign_key.h\"

${_key}
const struct bootutil_key bootutil_keys[] = {
    { .key = ecdsa_pub_key, .len = &ecdsa_pub_key_len },
};
const int bootutil_key_cnt = 1;
")
endif()
