# MCU part and family facts the options depend on. Every family adds its
# verified parts to the MCU choice (port/stm32<fam>/Kconfig.parts) and its
# own options (port/stm32<fam>/Kconfig).

config FAMILY_STM32F1
	bool
config FAMILY_STM32F4
	bool
config FAMILY_STM32H7
	bool
config MCU_DUALCORE
	bool

choice MCU_CHOICE
	prompt "MCU"
	help
	  The part on the board. Only parts the port is verified for are listed
	  (flash sectors, SRAM, peripherals): docs/porting.md, "Adding a part".

source "$(UMCUB_ROOT)/port/stm32f1/Kconfig.parts"
source "$(UMCUB_ROOT)/port/stm32f4/Kconfig.parts"
source "$(UMCUB_ROOT)/port/stm32h7/Kconfig.parts"

endchoice

config MCU
	string
	default "STM32F103xB" if MCU_STM32F103XB
	default "STM32F411xE" if MCU_STM32F411XE
	default "STM32H742xx" if MCU_STM32H742XX
	default "STM32H743xx" if MCU_STM32H743XX
	default "STM32H753xx" if MCU_STM32H753XX
	default "STM32H745xx" if MCU_STM32H745XX
	default "STM32H745xG" if MCU_STM32H745XG
	default "STM32H747xx" if MCU_STM32H747XX
	default "STM32H747xG" if MCU_STM32H747XG
	default "STM32H755xx" if MCU_STM32H755XX
	default "STM32H757xx" if MCU_STM32H757XX
	help
	  CMSIS device define of the part (selects the family port, startup and
	  CPU flags).

config MCU_PART
	string "Part number"
	default ""
	help
	  The part number as printed on the chip (or the CubeMX name), e.g.
	  STM32F411CEU6: the build then also refuses pins this package does not
	  bring out (ST pin data). Build check only, nothing in the image.
	  Empty: only the pins of the whole line are known.

source "$(UMCUB_ROOT)/port/stm32h7/Kconfig"
