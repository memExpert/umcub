# The part and what follows from it. The part choice, the per-part facts and
# the pin menus come from ST's pin data: port/kconfig_gen/*.kconfig, generated by
# tools/build/gen_kconfig.py (lines the ports support: LINES there).

config FAMILY_STM32F1
	bool
config FAMILY_STM32F4
	bool
config FAMILY_STM32G4
	bool
config FAMILY_STM32H7
	bool
config MCU_DUALCORE
	bool
# The flash switches between single- and dual-bank mode with an option bit
# (G4: DBANK), which changes the page size and the address of bank 2.
config HAS_FLASH_BANK_MODE
	bool
	default y if FAMILY_STM32G4

source "$(UMCUB_ROOT)/port/kconfig_gen/parts.kconfig"
source "$(UMCUB_ROOT)/port/kconfig_gen/pins.kconfig"

source "$(UMCUB_ROOT)/port/stm32h7/Kconfig"
