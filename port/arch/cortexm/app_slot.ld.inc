/*
 * Computes UMCUB_APP_FLASH_ORIGIN / UMCUB_APP_FLASH_LENGTH for the slot the
 * application is linked for. Input: UMCUB_APP_IMAGE (0/1), UMCUB_APP_SLOT
 * (0 primary, 1 secondary - only meaningful for direct-xip).
 * UMCUB_CFG_TRAILER_RESERVE bytes at the end of the slot are left for the
 * MCUboot trailer (imgtool --slot-size checks the exact value).
 */
#ifndef UMCUB_APP_IMAGE
#define UMCUB_APP_IMAGE 0
#endif
#ifndef UMCUB_APP_SLOT
#define UMCUB_APP_SLOT 0
#endif
#ifndef UMCUB_CFG_TRAILER_RESERVE
#define UMCUB_CFG_TRAILER_RESERVE 0x2000
#endif

#if UMCUB_APP_IMAGE == 0 && UMCUB_APP_SLOT == 0
#define UMCUB_APP_SLOT_ADDR UMCUB_CFG_IMG0_PRIMARY_ADDR
#define UMCUB_APP_SLOT_SIZE UMCUB_CFG_IMG0_PRIMARY_SIZE
#elif UMCUB_APP_IMAGE == 0
#define UMCUB_APP_SLOT_ADDR UMCUB_CFG_IMG0_SECONDARY_ADDR
#define UMCUB_APP_SLOT_SIZE UMCUB_CFG_IMG0_SECONDARY_SIZE
#elif UMCUB_APP_SLOT == 0
#define UMCUB_APP_SLOT_ADDR UMCUB_CFG_IMG1_PRIMARY_ADDR
#define UMCUB_APP_SLOT_SIZE UMCUB_CFG_IMG1_PRIMARY_SIZE
#else
#define UMCUB_APP_SLOT_ADDR UMCUB_CFG_IMG1_SECONDARY_ADDR
#define UMCUB_APP_SLOT_SIZE UMCUB_CFG_IMG1_SECONDARY_SIZE
#endif

#define UMCUB_APP_FLASH_ORIGIN (UMCUB_APP_SLOT_ADDR + UMCUB_CFG_IMAGE_HEADER_SIZE)
#define UMCUB_APP_FLASH_LENGTH (UMCUB_APP_SLOT_SIZE - UMCUB_CFG_IMAGE_HEADER_SIZE - UMCUB_CFG_TRAILER_RESERVE)
/* SRAM4 (64K) minus everything from the lowest handoff area up. */
#define UMCUB_APP_SRAM4_LENGTH (0x3800FE00 - 0x38000000)
