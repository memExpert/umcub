# umcub options (everything but the part and the family facts: port/Kconfig).
# What can be checked here is checked here (depends on, range); flash layout
# and pin checks: config/umcub_config_check.h and tools/build/check_pins.py.

choice DUALCORE_MODE_CHOICE
	prompt "Dual-core handling"
	depends on MCU_DUALCORE
	default DUALCORE_NONE
	help
	  Dual-core parts (STM32H745/H747/H755/H757).

config DUALCORE_NONE
	bool "Second core unused"
config DUALCORE_SINGLE_BOOT
	bool "One bootloader for both cores"
	help
	  One bootloader on the main core manages two images (image 0 = main
	  core, image 1 = second core) and releases the second core.
config DUALCORE_PER_CORE
	bool "A bootloader on each core"
	help
	  Every core runs its own bootloader instance with its own image(s) and
	  transports (two build trees, UMCUB_CORE cm7 and cm4).
endchoice

config DUALCORE_MODE
	int
	default 1 if DUALCORE_SINGLE_BOOT
	default 2 if DUALCORE_PER_CORE
	default 0

config CORE2_DONE_TIMEOUT_MS
	int "Wait for the second core's bootloader (ms)"
	depends on DUALCORE_PER_CORE && !CORE_CM4
	default 3000
	help
	  Main core: how long to wait for the second core's bootloader before
	  handing the clocks to the application. The application's SystemInit()
	  then stops the clock of the second core's CAN: to update that core over
	  CAN keep the main core in recovery (docs/configuration.md).

menu "Clocks"

choice CLOCK_SOURCE_CHOICE
	prompt "Clock source"
	default CLOCK_HSI
	help
	  The family port computes the PLL settings from it.
config CLOCK_HSI
	bool "HSI (internal oscillator)"
config CLOCK_HSE
	bool "HSE (crystal or external clock)"
endchoice

config CLOCK_SOURCE
	int
	default 1 if CLOCK_HSE
	default 0

config HSE_HZ
	int "HSE frequency (Hz)"
	depends on CLOCK_HSE
	range 4000000 50000000
	default 8000000
	help
	  Frequency of the crystal or of the external clock on OSC_IN. The family
	  port computes the PLL settings from it.

config HSE_BYPASS
	bool "HSE bypass (external clock instead of a crystal)"
	depends on CLOCK_HSE
	help
	  On: an external clock drives OSC_IN (e.g. the ST-LINK's MCO on a
	  Nucleo). Off: a crystal.

endmenu

menu "Flash layout"

config BOOT_ADDR
	hex "Bootloader address"
	default 0x08000000
	help
	  Start of the bootloader region, where the core starts: normally the
	  start of flash. The second core's bootloader of DUALCORE_PER_CORE lies
	  in bank 2 (option bytes: docs/configuration.md).

config BOOT_SIZE
	hex "Bootloader size"
	default 0x20000 if FAMILY_STM32H7
	default 0x8000
	help
	  Whole erase sectors. On large-sector parts (H7, F4) pick the
	  transports by the sector table in docs/size.md.

config LAYOUT_NO_UPGRADE
	bool "Slots MCUboot cannot upgrade between"
	help
	  Without it configure stops on slots whose sectors do not line up and on a
	  primary slot without a secondary one: MCUboot would refuse every upgrade
	  from the secondary slot and the application would simply stay. On: only recovery uploads straight into the primary slot
	  work, which allows a larger primary slot on a part with sectors of
	  different sizes.

config IMAGE_NUMBER
	int "Number of images"
	range 1 2
	default 2 if DUALCORE_SINGLE_BOOT
	default 1
	help
	  MCUboot images, each with its own slots. DUALCORE_SINGLE_BOOT needs 2:
	  image 1 is the second core's application.

config IMG0_PRIMARY_ADDR
	hex "Image 0 primary slot address"
	default 0x0
	help
	  The slots lie behind the bootloader on whole erase sectors. Pick them
	  by the size of your application: both slots the same size, the
	  secondary one sector larger for swap-offset, a scratch sector for
	  swap-scratch. MCUboot refuses upgrades unless the sectors of the two
	  slots line up (with sectors of different sizes: one sector per slot on
	  the F411); configure checks that. What is left stays free, e.g. for
	  the application's data. Configure prints the part's sectors until the slots are set.
config IMG0_PRIMARY_SIZE
	hex "Image 0 primary slot size"
	default 0x0
	help
	  The image runs from the primary slot: header, application, trailer
	  reserve. Whole erase sectors.
config IMG0_SECONDARY_ADDR
	hex "Image 0 secondary slot address"
	default 0x0
	help
	  Where an update waits until MCUboot installs it (direct-xip: the other
	  slot an image can run from). Whole erase sectors, outside the primary
	  slot.
config IMG0_SECONDARY_SIZE
	hex "Image 0 secondary slot size"
	default 0x0
	help
	  The same as the primary slot; swap-offset needs a secondary slot one
	  sector larger.

config IMG1_PRIMARY_ADDR
	hex "Image 1 primary slot address"
	default 0x0
	depends on IMAGE_NUMBER = 2
	help
	  Image 1 (with DUALCORE_SINGLE_BOOT the second core's application); the
	  same rules as image 0's primary slot.
config IMG1_PRIMARY_SIZE
	hex "Image 1 primary slot size"
	default 0x0
	depends on IMAGE_NUMBER = 2
	help
	  The same rules as image 0's primary slot.
config IMG1_SECONDARY_ADDR
	hex "Image 1 secondary slot address"
	default 0x0
	depends on IMAGE_NUMBER = 2
	help
	  The same rules as image 0's secondary slot.
config IMG1_SECONDARY_SIZE
	hex "Image 1 secondary slot size"
	default 0x0
	depends on IMAGE_NUMBER = 2
	help
	  The same rules as image 0's secondary slot.

config SCRATCH_ADDR
	hex "Scratch area address"
	default 0x0
	depends on UPGRADE_MODE_SWAP_SCRATCH
	help
	  swap-scratch: where MCUboot keeps a sector while it swaps it. Whole
	  erase sectors, outside the slots. It wears fastest: erased once per
	  moved sector on every update.
config SCRATCH_SIZE
	hex "Scratch area size"
	default 0x0
	depends on UPGRADE_MODE_SWAP_SCRATCH
	help
	  At least the largest sector of the slots (configure checks it).

config IMAGE_HEADER_SIZE
	hex "Image header size"
	default 0x200 if FAMILY_STM32F1 || FAMILY_STM32F4
	default 0x400
	help
	  Reserved by imgtool (--header-size). Must keep the application vector
	  table aligned as the core requires (VTOR).

config TRAILER_RESERVE
	hex "Trailer reserve"
	default 0x400 if FAMILY_STM32F1
	default 0x2000
	help
	  Bytes at the end of every slot the application must not use (MCUboot
	  trailer and the TLVs imgtool appends; imgtool --slot-size checks it).
	  Swap modes need room for the swap status, overwrite only a few dozen
	  bytes.

config ERASE_PROGRESSIVELY
	bool "SMP upload erases sector by sector"
	default y
	help
	  Off: the whole slot is erased on the first chunk (seconds on big
	  sectors).

config NODE_ADDR_FLASH
	hex "Node address word in flash"
	default 0x0
	help
	  Address of a 32-bit word in flash holding the node address as
	  UMCUB_NODE_ADDR_WORD(addr) (umcub.h), e.g. a field of the application's
	  own settings: the address is known right after power-up, before the
	  application has run. Must lie outside the image slots (updates rewrite
	  them). 0 = not used.
	  The node address on a shared bus comes, in this order, from the
	  application (umcub_set_node_address(), kept over resets, not over
	  power-off), from this word, or from the board hook
	  umcub_board_node_address() (DIP switch, EEPROM, ...); 0 = unassigned.

endmenu

menu "MCUboot"

choice UPGRADE_MODE_CHOICE
	prompt "Upgrade mode"
	default UPGRADE_MODE_OVERWRITE
	help
	  How MCUboot installs an image from the secondary slot. The mode decides
	  what the slots must look like: menu Flash layout, docs/board.md.
config UPGRADE_MODE_OVERWRITE
	bool "overwrite"
	help
	  The image in the secondary slot replaces the primary one: no test boot,
	  no way back. The trailer takes only a few dozen bytes.
config UPGRADE_MODE_SWAP_SCRATCH
	bool "swap-scratch"
	help
	  The two slots are swapped through a scratch area: an image on test that
	  the application does not confirm (umcub_confirm()) is swapped back by
	  the next boot.
config UPGRADE_MODE_SWAP_OFFSET
	bool "swap-offset"
	help
	  The two slots are swapped without a scratch area, test and revert like
	  swap-scratch, with a secondary slot one sector larger than the primary.
	  Spreads the wear better than swap-scratch; recommended by MCUboot.
config UPGRADE_MODE_DIRECT_XIP
	bool "direct-xip"
	help
	  Nothing is copied: an image runs from the slot it was linked for and the
	  newest valid one wins. An SMP upload names the slot. No encrypted
	  images, no downgrade prevention.
config UPGRADE_MODE_DIRECT_XIP_REVERT
	bool "direct-xip with revert"
	help
	  direct-xip, and MCUboot erases an image without a confirmed trailer on
	  the next boot: programmers and serial recovery take the .confirmed
	  image, updates are followed by umcub_confirm() (docs/configuration.md).
endchoice

config UPGRADE_MODE
	int
	default 2 if UPGRADE_MODE_SWAP_SCRATCH
	default 4 if UPGRADE_MODE_SWAP_OFFSET
	default 5 if UPGRADE_MODE_DIRECT_XIP
	default 6 if UPGRADE_MODE_DIRECT_XIP_REVERT
	default 1

choice SIGNATURE_CHOICE
	prompt "Image signature"
	default SIGNATURE_EC256
	help
	  What an image must carry to be accepted.
config SIGNATURE_EC256
	bool "ECDSA-P256"
	help
	  Images are signed with the signing key (menu Keys); the bootloader
	  embeds its public half.
config SIGNATURE_NONE
	bool "None (SHA-256 only)"
	help
	  Images carry a SHA-256 only: damaged ones are refused, but anybody's
	  are booted (no authenticity; about 4.6 K smaller). Only for closed
	  devices on small parts.
endchoice

config SIGNATURE
	int
	default 0 if SIGNATURE_NONE
	default 1

config DOWNGRADE_PREVENTION
	bool "Refuse older images"
	depends on !UPGRADE_MODE_DIRECT_XIP && !UPGRADE_MODE_DIRECT_XIP_REVERT
	help
	  Refuse images with a lower version than the running one. MCUboot checks
	  it when it installs from the secondary slot (DFU, lite upload,
	  umcub_slot_*, SMP with SMP_DIRECT_UPLOAD): the image is dropped, the
	  running one stays. A plain SMP upload writes the primary slot directly
	  and is not checked. Not in the direct-xip modes: the newest valid image
	  wins anyway.

config VALIDATE_PRIMARY
	bool "Validate the primary slot on every boot"
	default y
	help
	  Validate the primary slot (hash + signature, board type, reset vector)
	  on every boot, recommended. Off boots faster (about 0.6 s on a 72 MHz
	  Cortex-M3, about 80 ms per image on the H7): updates through the
	  secondary slot are still validated before they are installed, but an
	  image written straight into the primary slot (SMP or lite upload, a
	  debugger) then boots unchecked. Refused at build time together with SMP
	  and a board type, a secure link or encrypted images.

config IMAGE_VECTOR_CHECK
	bool "Check the image's reset vector"
	default y
	help
	  Refuse an image whose reset vector lies outside the slot it runs from
	  (wrong image number, built for the other core), about 200 bytes.

config ENCRYPT_IMAGES
	bool "Encrypted images"
	depends on !UPGRADE_MODE_DIRECT_XIP && !UPGRADE_MODE_DIRECT_XIP_REVERT
	help
	  MCUboot ECIES-P256, AES-128-CTR with the device key (menu Keys): image
	  files and transfers do not show the firmware; signing encrypts
	  automatically. Installed from the secondary slot, the image is decrypted
	  while it is copied; uploaded over SMP into the primary slot, it is
	  decrypted in place after the last chunk. READBACK then answers only
	  inside an encrypted umcub link session, never over USB DFU.

config ENC_INPLACE
	bool "In-place decryption after an SMP upload"
	depends on ENCRYPT_IMAGES
	default n if FAMILY_STM32F4 || CORE_CM4
	default y
	help
	  Decrypt an encrypted SMP upload into the primary slot in place. Buffers
	  one flash sector in RAM (H7: 128 KiB), so the part needs sectors of one
	  size. Without it encrypted images go through the secondary slot.

config SWAP_SAVE_ENCTLV
	bool "Keep encrypted key TLVs in the trailer"
	depends on ENCRYPT_IMAGES
	default y
	help
	  Swap modes: the slot trailers keep the encrypted key TLVs of both images
	  until the swap is over (signing passes --save-enctlv). Off stores the
	  plain AES keys there, readable with a debugger or readback, for a
	  slightly smaller trailer.

endmenu

menu "Entering the bootloader"

config ENTRY_ON_REQUEST
	bool "On request of the application"
	default y
	help
	  Stay in recovery when the application asked for it
	  (umcub_enter_bootloader()). Off can lock the device out: without a
	  button or a wait window nothing else brings it back.
config ENTRY_ON_NO_IMAGE
	bool "When there is no valid image"
	default y
	help
	  Stay in recovery when no image is bootable. Off: a device without a
	  valid image is unreachable (debugger only).

config ENTRY_GPIO
	bool "Button / strap pin held at reset"
	help
	  Stay in recovery when this pin is held at reset.
if ENTRY_GPIO
source "$(UMCUB_ROOT)/port/kconfig_gen/entry_gpio.kconfig"
endif
config ENTRY_GPIO_ACTIVE
	bool "Entry pin active high"
	depends on ENTRY_GPIO
	default y
	help
	  On: the pin held high means recovery. Off: held low.
choice ENTRY_GPIO_PULL_CHOICE
	prompt "Entry pin pull"
	depends on ENTRY_GPIO
	default ENTRY_GPIO_PULL_NONE
	help
	  Internal pull while the pin is read; none when the board has its own
	  resistor.
config ENTRY_GPIO_PULL_NONE
	bool "none"
config ENTRY_GPIO_PULL_UP
	bool "pull-up"
config ENTRY_GPIO_PULL_DOWN
	bool "pull-down"
endchoice
config ENTRY_GPIO_PULL
	int
	default 1 if ENTRY_GPIO_PULL_UP
	default 2 if ENTRY_GPIO_PULL_DOWN
	default 0

config ENTRY_WAIT_MS
	int "Wait window on every boot (ms)"
	default 0
	help
	  Listen this long on every boot for an SMP request or a text command such
	  as "b" before starting the application (0 = don't wait); each boot is
	  delayed by it. Every enabled transport listens and is switched off again
	  after the window, so pick the length for the slowest one you want to
	  use: UART and CAN answer at once; Ethernet needs the link (about 2 s)
	  and a DHCP lease or a static address; USB needs the host to enumerate
	  and open the device (seconds). USB attaches and detaches on every boot
	  then, and a device that vanishes in the middle of enumeration upsets
	  some host controllers: with USB prefer 0 or a window of several seconds.

config RECOVERY_TIMEOUT_MS
	int "Leave recovery after inactivity (ms)"
	default 0
	help
	  Leave recovery mode (reset) after this much inactivity. 0 = never.

config STATUS_LED
	bool "Status LED"
	help
	  Lit while the bootloader listens (wait window, recovery), shows what the
	  log would say when there is none. About 200 bytes.
	  Slow blink (1 Hz): in the bootloader, waiting.
	  Fast flicker: data arriving.
	  N blinks + pause: a transport did not come up (no transceiver, no PHY
	  clock, ...), N = 1 UART, 2 USB, 4 CAN, 5 Ethernet, 7 board transport.
	  Untouched on a plain boot; back in reset state before the application.
if STATUS_LED
source "$(UMCUB_ROOT)/port/kconfig_gen/status_led.kconfig"
endif
config STATUS_LED_ACTIVE
	bool "LED lit high"
	depends on STATUS_LED
	default y
	help
	  On: the LED is lit when the pin is high. Off: when it is low.

endmenu

menu "Recovery protocols"

config SMP_ENABLE
	bool "SMP (MCUboot serial recovery)"
	default y
	help
	  MCUboot serial recovery (mcumgr / smpmgr / umcub) on UART, USB CDC, CAN,
	  UDP and the board transport. Off leaves boot_serial, zcbor and the SMP
	  framing out (about 6 K): images then come through the lite upload, USB
	  DFU, the application (umcub_slot_*) or the board's own protocol.

config SMP_MTU
	int "Largest packet (SMP, lite upload, link, CAN)"
	range 512 4096
	default 1472 if TRANSPORT_ETH
	default 1024
	help
	  Largest packet (decoded) on SMP, the lite upload, the umcub link and
	  CAN; the buffers are this size (RAM only). By default 1472 with Ethernet
	  (a full UDP datagram, what smpmgr sends), else 1024. Hosts must not send
	  more: smpmgr --mtu / --line-buffers.

config SMP_PARAMS
	bool "Answer MCUMGR_PARAMETERS"
	depends on SMP_ENABLE
	default y
	help
	  Answer MCUMGR_PARAMETERS (os group, id 6) with buf_size = SMP_MTU,
	  buf_count = 1: smpmgr then sizes serial packets itself, no
	  --line-buffers. About 130 bytes.

config SMP_DIRECT_UPLOAD
	bool "SMP upload addresses slots"
	depends on SMP_ENABLE
	help
	  Where an SMP upload goes. Off: "image" N is image N, written straight
	  into its primary slot (replaced at once, no revert). On: "image"
	  addresses slots: 0/1 image 0 primary, 2 image 0 secondary, 3 image 1
	  primary, 4 image 1 secondary; an image in the secondary slot is
	  installed by the next boot after "image state-write" marks it (test
	  boot, revert in the swap modes). Always on in the direct-xip modes.
	  Brings MCUboot's image state ("image state-write", the confirmed and
	  pending flags in "image state-read"; not in direct-xip), the image hash
	  in "state-read" and "image slot-info" along, about 2.4 K; without it
	  "state-read" lists versions only.

config SMP_INSPECT_GROUP
	int "SMP group of verify / hash / read"
	depends on SMP_ENABLE
	default 100
	help
	  SMP group id of verify (0) / hash (1) / read (2).

config LITE_UPLOAD
	bool "Lite upload protocol"
	default y if !SMP_ENABLE
	help
	  Small upload protocol without SMP (umcub upload --lite): begin / data /
	  end frames with CRC, written with umcub_slot_* (test or permanent mark,
	  in-place decryption). On by default without SMP.

config PROTO_USER
	bool "Board protocol (umcub_proto_user)"
	help
	  Frames that are neither SMP, lite nor a text command go to
	  umcub_proto_user() in the board code (packets of packet transports and
	  umcub link DATA payloads; on stream transports lines 0x05 0x0E <base64>
	  \n). Answer with umcub_proto_reply(); umcub_slot_* is available to write
	  images. Example: boards/blackpill_f411ce, variants/proto_user.conf.

config CMD_ENABLE
	bool "Text commands"
	help
	  Simple text commands next to SMP, for a terminal or a few lines of host
	  code: on stream transports (UART, USB CDC) typed text, on packet
	  transports (UDP, CAN ISO-TP) a packet that is not an SMP frame. They are
	  listened to in recovery mode and during the wait window (ENTRY_WAIT_MS),
	  e.g. "send b within 300 ms after reset to stay in the bootloader". By
	  default a / b / r / i (start the application, stay, reset, info) and
	  verify / hash / read: CMD_TABLE.
config CMD_TABLE
	string "Command table"
	depends on CMD_ENABLE
	default "a=BOOT_APP b=STAY r=RESET i=INFO +inspect"
	help
	  The text commands as name=ACTION, separated by spaces. ACTION:
	  BOOT_APP, STAY, RESET, INFO, VERIFY, HASH, READ, USER<n> (the board's
	  umcub_cmd_user(n, ...)). +inspect adds verify, hash and read where
	  they are on and SMP is off, +inspect_read also with SMP.

config CMD_IMMEDIATE
	bool "Run a command as soon as the input equals it"
	depends on CMD_ENABLE
	default y
	help
	  On: a command runs as soon as the input equals it (a single key). Off:
	  only after Enter (CR or LF). A command that is the beginning of another
	  one ("r" and "read") always waits for Enter.
config CMD_REPLY
	bool "Answer text commands"
	depends on CMD_ENABLE
	default y
	help
	  Text commands answer "ok <cmd>" / "? <text>".

config INSPECT_VERIFY
	bool "Slot verify (host checks an image)"
	default y
	help
	  "verify <image> <slot>": full MCUboot validation of the slot (SHA-256
	  over flash + signature), answers "ok valid" / "bad". Also in the SMP
	  inspect group.
config INSPECT_HASH
	bool "Slot hash"
	default y
	help
	  "hash <image> <slot> [<off> <len>]": SHA-256 of a slot range; by default
	  the whole stored image, the .signed.bin that was sent. Also in the SMP
	  inspect group.
config READBACK
	bool "Slot readback"
	help
	  "read <image> <slot> <off> <len>", SMP read and USB DFU upload: raw
	  readback of the image slots. Exposes the firmware to anybody who can put
	  the device into recovery mode. The bootloader region is never readable.

endmenu

menu "Transports"

config TRANSPORT_UART
	bool "UART"
	default y
	help
	  SMP serial (mcumgr / smpmgr --conntype serial) and text commands. The
	  boot log goes to this UART too.
if TRANSPORT_UART
source "$(UMCUB_ROOT)/port/kconfig_gen/uart_instance.kconfig"
config UART_BAUD
	int "Baud rate"
	default 115200
	help
	  Baud rate of the transport and of the boot log.
source "$(UMCUB_ROOT)/port/kconfig_gen/uart_tx.kconfig"
source "$(UMCUB_ROOT)/port/kconfig_gen/uart_rx.kconfig"
source "$(UMCUB_ROOT)/port/kconfig_gen/uart_de.kconfig"
config UART_DE_ACTIVE
	bool "DE active high"
	default y
	help
	  On: DE is high while sending. Off: low.
config UART_TURNAROUND_MS
	int "Pause before answering (ms)"
	default 0
	help
	  Pause before answering, so the host has released the bus.
config UART_TX_RING
	int "Transmit ring (bytes, power of two, 0 = off)"
	default 0
	help
	  Transmit through a RAM ring of this many bytes drained by the UART
	  interrupt, so the log does not stall the boot (drained before the jump);
	  the last lines can be lost on a hang. Not with RS485.
endif

config TRANSPORT_USB_CDC
	bool "USB CDC (SMP)"
	depends on HAS_USB
	help
	  CDC-ACM (tinyUSB), a serial port on the host: SMP and text commands.
config TRANSPORT_USB_DFU
	bool "USB DFU"
	depends on HAS_USB
	help
	  DFU (tinyUSB, dfu-util): alt setting N = image N, downloaded into its
	  secondary slot (also in direct-xip) and marked pending after
	  manifestation.
if TRANSPORT_USB_CDC || TRANSPORT_USB_DFU
config USB_VID
	hex "USB vendor id"
	default 0x1209
	help
	  The default 1209:0001 is a test id of pid.codes: a product needs its
	  own.
config USB_PID
	hex "USB product id"
	default 0x0001
	help
	  See the vendor id.
config USB_MANUFACTURER
	string "USB manufacturer"
	default "umcub"
	help
	  String descriptor, what the host shows.
config USB_PRODUCT
	string "USB product"
	default "umcub bootloader"
	help
	  String descriptor, what the host shows.
endif
config USB_DFU_ALLOW_UNAUTH
	bool "USB DFU next to an authenticated link"
	depends on TRANSPORT_USB_DFU
	help
	  USB DFU cannot authenticate the host: next to a secure link it is
	  refused at build time unless this is on.

config TRANSPORT_CAN
	bool "CAN (SMP over ISO-TP)"
	help
	  SMP over ISO-TP. On the STM32F1 not together with USB: they share their
	  SRAM.
if TRANSPORT_CAN
choice CAN_DRIVER_CHOICE
	prompt "CAN controller"
	default CAN_DRIVER_PORT
	help
	  Who drives the CAN controller.
config CAN_DRIVER_PORT
	bool "On-chip (FDCAN / bxCAN)"
	depends on HAS_CAN
	help
	  The family port's FDCAN / bxCAN driver.
config CAN_DRIVER_BOARD
	bool "External, driver in the board code"
	help
	  An external controller, e.g. MCP2515 / MCP2518FD on SPI: the board code
	  implements umcub_port_can_init / deinit / send / recv
	  (port/include/umcub_port_can.h), ISO-TP and SMP run on top of it.
	  EXPERIMENTAL: host test only, not run with a real controller yet.
endchoice
config CAN_DRIVER
	int
	default 1 if CAN_DRIVER_BOARD
	default 0
config CAN_INSTANCE
	int
	default 1
config CAN_BITRATE
	int "Bit rate"
	default 500000
	help
	  Nominal bit rate (bit/s).
config CAN_FD
	bool "CAN-FD frames"
	help
	  CAN-FD frames, up to 64 bytes; not on the F1's bxCAN. EXPERIMENTAL:
	  loopback only, not run on a bus yet.
config CAN_DATA_BITRATE
	int "Data bit rate"
	depends on CAN_FD
	default 2000000
	help
	  Bit rate of the CAN-FD data phase (bit/s).
config CAN_RX_ID
	hex "Id host -> device"
	default 0x7C0
	help
	  CAN id of the frames from the host.
config CAN_TX_ID
	hex "Id device -> host"
	default 0x7C8
	help
	  CAN id of the frames to the host.
config CAN_EXT_ID
	bool "29-bit ids"
	help
	  29-bit ids instead of 11-bit ones.
if CAN_DRIVER_PORT
source "$(UMCUB_ROOT)/port/kconfig_gen/can_tx.kconfig"
source "$(UMCUB_ROOT)/port/kconfig_gen/can_rx.kconfig"
endif
config CAN_LOOPBACK
	bool "Internal loopback (self-test)"
	help
	  No transceiver needed, nothing reaches the bus: for self-test only.
endif

config TRANSPORT_ETH
	bool "Ethernet (SMP over UDP)"
	help
	  SMP and text commands over UDP, on a minimal IPv4 stack with DHCP.
	  Recovery over the network is not authenticated without the secure link.
if TRANSPORT_ETH
choice ETH_DRIVER_CHOICE
	prompt "Ethernet MAC"
	default ETH_DRIVER_PORT
	help
	  Who drives the Ethernet MAC.
config ETH_DRIVER_PORT
	bool "On-chip MAC + RMII PHY"
	depends on HAS_ETH
	help
