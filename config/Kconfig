menu "Board identity"

config BOARD_TYPE
	hex "Board type"
	default 0x0
	help
	  Product id. Non-zero: every image must carry it in its signed TLV
	  (signing adds it), firmware of another product is never booted.
config BOARD_REV
	int "Hardware revision"
	range 0 65535
	default 0

endmenu

menu "Keys"

config KEYS_DIR
	string "Directory of the generated keys"
	default ""
	help
	  Where "Generate" keys are made: empty is keys/<board> in the umcub
	  root (without a board keys/<part>); a relative path is taken from the
	  umcub root. A key that exists there is used, never replaced: keep the
	  directory (and a backup), the devices only accept what its keys sign.

choice SIGNING_KEY_SOURCE
	prompt "Image signing key"
	depends on SIGNATURE_EC256
	default SIGNING_KEY_GENERATE
	help
	  ECDSA-P256 key that signs the images; its public half is embedded in
	  the bootloader.
config SIGNING_KEY_GENERATE
	bool "Generate (signing.pem in the keys directory)"
config SIGNING_KEY_FILE
	bool "Existing key file"
config SIGNING_KEY_DEV
	bool "Development key of the repository (insecure)"
	help
	  tools/keys/dev-ecdsa-p256.pem: public, for tests and examples only.
endchoice

config SIGNING_KEY_PATH
	string "Image signing key file (PEM)"
	depends on SIGNING_KEY_FILE
	help
	  Absolute, or relative to the umcub root.

choice DEVICE_KEY_SOURCE
	prompt "Device key"
	depends on ENCRYPT_IMAGES || LINK_SECURE
	default DEVICE_KEY_GENERATE
	help
	  EC P-256 private key of the device: decrypts encrypted images and is
	  the static key of the SECURE link (key agreement). Images are
	  encrypted for its public half.
config DEVICE_KEY_GENERATE
	bool "Generate (device.pem in the keys directory)"
config DEVICE_KEY_FILE
	bool "Existing key file"
config DEVICE_KEY_DEV
	bool "Development key of the repository (insecure)"
	help
	  tools/keys/dev-device-p256.pem: public, for tests and examples only.
endchoice

config DEVICE_KEY_PATH
	string "Device key file (PEM)"
	depends on DEVICE_KEY_FILE
	help
	  Absolute, or relative to the umcub root.

choice ADMIN_KEY_SOURCE
	prompt "Admin (host) key"
	depends on LINK_SECURE
	default ADMIN_KEY_GENERATE
	help
	  EC P-256 key of the hosts that may open a SECURE link session; only
	  its public half is embedded in the bootloader.
config ADMIN_KEY_GENERATE
	bool "Generate (admin.pem in the keys directory)"
config ADMIN_KEY_FILE
	bool "Existing key file"
config ADMIN_KEY_DEV
	bool "Development key of the repository (insecure)"
	help
	  tools/keys/dev-admin-p256.pem: public, for tests and examples only.
endchoice

config ADMIN_KEY_PATH
	string "Admin (host) key file (PEM)"
	depends on ADMIN_KEY_FILE
	help
	  Absolute, or relative to the umcub root.

endmenu

menu "Misc"

config LOG_LEVEL
	int "Boot log level"
	range 0 4
	default 0
	help
	  On the UART: 0 off, 1 error, 2 warning, 3 info, 4 debug. Level 3
	  costs about 3.5 K.
config MCUBOOT_LOG_LEVEL
	int "MCUboot log level"
	range 0 LOG_LEVEL
	default LOG_LEVEL
config ASSERT_TRAP
	bool "MCUboot asserts trap silently"
	help
	  A failed assertion traps (HardFault -> reset) instead of logging
	  file:line: smaller, but silent.
config LTO
	bool "Link-time optimisation"
	help
	  3-4 K smaller on Cortex-M3 / M4, about 7 K on the H7. Verified on the
	  F1 and the F4, EXPERIMENTAL on the H7. CMake -DUMCUB_LTO overrides it.
config WATCHDOG_MS
	int "Independent watchdog (ms, 0 = off)"
	default 0
	help
	  At least 1.5 x the erase time of one sector (H7 6 s, F4 3 s, F1 60 ms).
config TEST_FAULT_INJECT
	bool "TEST ONLY: power-loss emulation"
	help
	  Reset in the middle of a flash operation (tests/hw/powerfail_test.py).
	  Never in production.

endmenu
