	int
	default 1 if ETH_DRIVER_BOARD
	default 0
config ETH_DHCP
	bool "DHCP"
	default y
	help
	  Ask for an address over DHCP, with the static address as a fallback.
config ETH_IP
	string "Static address (fallback with DHCP)"
	default "192.168.1.50"
	help
	  Used when DHCP is off, or as a fallback when no lease comes.
config ETH_NETMASK
	string "Netmask"
	default "255.255.255.0"
	help
	  Netmask of the static address.
config ETH_DHCP_TIMEOUT_MS
	int "DHCP fallback after (ms)"
	depends on ETH_DHCP
	default 10000
	help
	  Fall back to the static address when no DHCP lease comes in this time.
config ETH_MAC
	hex "MAC address (0 = from the unique id)"
	default 0x0
	help
	  As a 48-bit number, first byte on top. 0 = derived from the MCU's unique
	  id (locally administered).
config ETH_SMP_PORT
	int "UDP port of SMP"
	default 1337
	help
	  UDP port the bootloader listens on.
config ETH_PHY_ADDR
	int "PHY address"
	depends on ETH_DRIVER_PORT
	default 0
	help
	  MDIO address of the RMII PHY.
if ETH_DRIVER_PORT
menu "RMII pins"
source "$(UMCUB_ROOT)/port/kconfig_gen/eth_rmii.kconfig"
endmenu
endif
endif

config TRANSPORT_USER
	bool "Board transport (umcub_transport_user)"
	help
	  Anything else (RS-485 with its own framing, a BLE module, a W5500 UDP
	  socket, ...): the board code defines const umcub_transport_t
	  umcub_transport_user (src/transport/include/umcub_transport.h), a stream
	  (SMP serial framing) or a packet transport (raw SMP packets), polled
	  with the built-in ones. EXPERIMENTAL: host test only, not run with real
	  hardware yet.

endmenu

menu "umcub link (several devices on one bus)"

