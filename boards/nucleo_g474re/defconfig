# NUCLEO-G474RE (MB1367, UM2505: STM32G474RET6, 512 KiB flash, 128 KiB SRAM,
# 24 MHz crystal X3, LED LD2 on PA5, B1 USER button on PC13). Minimal build:
# SMP over USART2 on PA2/PA3 - the pins the ST-LINK virtual COM port has by
# default (SB17 / SB23, meant for LPUART1) - overwrite mode.
UMCUB_CFG_PART_STM32G474RETX=y
# images must carry this (signed TLV)
UMCUB_CFG_BOARD_TYPE=0x47474001
UMCUB_CFG_BOARD_REV=1

UMCUB_CFG_CLOCK_HSE=y
UMCUB_CFG_HSE_HZ=24000000

# Dual-bank mode (option bit DBANK, the factory setting): 2 x 128 pages of
# 2 KiB. Bootloader 32 KiB; the slots, 224 KiB each, end on 4 KiB boundaries
# as well (variants/single_bank.conf keeps them); the last 32 KiB stay free.
UMCUB_CFG_BOOT_SIZE=0x8000
UMCUB_CFG_IMG0_PRIMARY_ADDR=0x08008000
UMCUB_CFG_IMG0_PRIMARY_SIZE=0x38000
UMCUB_CFG_IMG0_SECONDARY_ADDR=0x08040000
UMCUB_CFG_IMG0_SECONDARY_SIZE=0x38000

# B1 USER (PC13, high when pressed) held at reset: stay in recovery.
UMCUB_CFG_ENTRY_GPIO=y
UMCUB_CFG_ENTRY_GPIO_PC13=y
UMCUB_CFG_ENTRY_GPIO_ACTIVE=y

# LD2 (PA5, lit high): blinks while in the bootloader
UMCUB_CFG_STATUS_LED=y
UMCUB_CFG_STATUS_LED_PA5=y
UMCUB_CFG_STATUS_LED_ACTIVE=y

UMCUB_CFG_CMD_ENABLE=y

UMCUB_CFG_TRANSPORT_UART=y
UMCUB_CFG_UART_INSTANCE_2=y
UMCUB_CFG_UART_BAUD=115200
UMCUB_CFG_UART_TX_PA2=y
UMCUB_CFG_UART_RX_PA3=y

UMCUB_CFG_LOG_LEVEL=3
